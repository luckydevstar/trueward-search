# ---------------------------------------------------------------------------
# Supabase — the same project as Trueward Guru and the calendar.
#
# Sign-in uses the tracker's accounts, admins only: the policies in
# supabase/schema.sql ask `app_user` for the role. There is no user table here
# and no way to create an account.
#
# These two are the whole deployment. There is deliberately no service-role
# key: refreshing is a button an admin presses, so it runs under their own
# session and RLS decides. Nothing in the app needs to bypass RLS, so nothing
# in the app can.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe in the browser: every query it makes is filtered by those policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Local only — NOT a deployment variable.
#
# `npm run scrape` runs from a terminal, which has no session to carry, so it
# needs the key that bypasses RLS. Only scripts/scrape-cli.ts reads it;
# nothing under src/ does.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Scraping behaviour
# ---------------------------------------------------------------------------
# Ignore jobs posted more than this many days ago
MAX_AGE_DAYS=7

# Adzuna official API keys (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Caps on detail-page fetches per refresh (keeps request volume polite;
# leftovers are picked up the next time you refresh).
LINKEDIN_MAX_DETAILS=120
JOBGETHER_MAX_DETAILS=150
JOBRIGHT_MAX_DETAILS=80
