# ---------------------------------------------------------------------------
# Supabase — the same project as Trueward Guru and the calendar.
#
# Sign-in uses the tracker's accounts, admins only: the policies in
# supabase/schema.sql ask `app_user` for the role. There is no user table here
# and no way to create an account.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Safe in the browser: every query it makes is filtered by those policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Scheduled scraping
#
# A cron run has no user behind it, so there is no auth.uid() for RLS to test
# and it needs the key that bypasses RLS. Both of these are required together:
# the cron route refuses outright unless CRON_SECRET is set, so the
# service-role key is never reachable by an unauthenticated request.
#
# The "Refresh now" button does NOT use either — that runs as the signed-in
# admin, under RLS, because there is a person there to be.
#
# Generate a secret:  openssl rand -base64 32
# ---------------------------------------------------------------------------
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Scraping behaviour
# ---------------------------------------------------------------------------
REFRESH_MINUTES=30
MAX_AGE_DAYS=7

# Adzuna official API keys (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Caps on detail-page fetches per refresh (keeps request volume polite).
LINKEDIN_MAX_DETAILS=120
JOBGETHER_MAX_DETAILS=150
JOBRIGHT_MAX_DETAILS=80
