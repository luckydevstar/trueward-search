# Server port (the built frontend is served from here too)
PORT=4000

# Minutes between automatic refreshes (set AUTO_REFRESH=false to only refresh on demand)
REFRESH_MINUTES=30
AUTO_REFRESH=true

# Ignore jobs posted more than this many days ago
MAX_AGE_DAYS=7

# Adzuna official API keys (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Caps on detail-page fetches per refresh (keeps request volume polite; leftovers are fetched next run)
LINKEDIN_MAX_DETAILS=120
JOBGETHER_MAX_DETAILS=150
JOBRIGHT_MAX_DETAILS=80

# ---------------------------------------------------------------------------
# Sign-in — Trueward Guru's accounts, admins only.
#
# The same Supabase project as the tracker and the calendar. This app has no
# user table and creates nobody; it checks the tracker's `app_user` for the
# signing-in account's role and admits `admin` and `super_admin`.
#
# The anon key is the only Supabase credential here, and it is safe: it never
# reaches the browser (the session is an httpOnly cookie), and every read it
# makes is filtered by the tracker's own RLS. There is deliberately no
# service-role key — nothing in this app needs to bypass RLS.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
